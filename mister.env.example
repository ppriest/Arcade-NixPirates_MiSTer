# Core-specific overrides. Copy this file to mister.env (gitignored);
# environment variables override both it and ~/.mister-core.env.

# The MAME driver source this core follows, for extract_dips.py, extract_romstart.py
# and validate_mra.py.
#MAME_SRC=/path/to/mame/src/mame/<maker>/<driver>.cpp

# Override the machine's MiSTer or toolchain for this core only.
#MISTER_HOST=
#MISTER_USER=
#MISTER_PASSWORD=
#MAME_DIR=
#MAME_EXE=
#QUARTUS_BIN=
#MODELSIM_BIN=
